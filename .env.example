# Optional. The public Kalshi read endpoints used by discovery/capture need NO credentials.
# Authenticated endpoints (orders, fills, portfolio) are not used by this repo yet.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM_PATH=
# Kalshi base URL (production). Demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# Optional: The Odds API key for sportsbook baselines (free tier: 500 req/month). Not required.
ODDS_API_KEY=
# Local data root (defaults to ./data)
NBA_EDGE_DATA_ROOT=
